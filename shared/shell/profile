# Prefer the native Apple Silicon installation over a stale Intel Homebrew
# that may still be inherited from a terminal application's environment.
if [ "$(uname -m)" = "arm64" ] && [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# shellcheck source=/dev/null
[ -r "$HOME/.config/dotfiles/shared/shell/path.sh" ] && . "$HOME/.config/dotfiles/shared/shell/path.sh"
