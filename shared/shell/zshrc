export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.config/dotfiles}"

# GUI terminals may start an interactive, non-login Zsh. Load the shared
# profile here as well so Homebrew-backed prompt and completion tools are on
# PATH in Ghostty, Codex, and login shells alike.
[[ -r "$HOME/.profile" ]] && source "$HOME/.profile"

# History stays local to each machine.
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt append_history share_history hist_ignore_dups hist_reduce_blanks

# Source the first packaged copy of a plugin. Arch and Homebrew deliberately
# use different installation prefixes.
source_first() {
  local candidate
  for candidate in "$@"; do
    if [[ -r "$candidate" ]]; then
      source "$candidate"
      return 0
    fi
  done
  return 1
}

brew_prefix="${HOMEBREW_PREFIX:-}"
if [[ -z "$brew_prefix" ]] && command -v brew >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix)"
fi

# zsh-autocomplete persists recent directories here, but its writer expects
# the parent directory to exist before the first directory change.
zsh_recent_dirs_parent="${XDG_DATA_HOME:-$HOME/.local/share}/zsh"
[[ -d "$zsh_recent_dirs_parent" ]] || mkdir -p -- "$zsh_recent_dirs_parent"
unset zsh_recent_dirs_parent

# zsh-autocomplete must load before Oh My Zsh calls compinit/compdef.
autocomplete_loaded=0
source_first \
  /usr/share/zsh/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh \
  "$brew_prefix/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" && autocomplete_loaded=1

if [[ -r "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  ZSH_THEME=""
  plugins=(
    git
    sudo
    web-search
    copypath
    copyfile
    copybuffer
    dirhistory
    colored-man-pages
    command-not-found
  )
  [[ "$(uname -s)" == Darwin ]] && plugins+=(macos)
  source "$ZSH/oh-my-zsh.sh"
elif (( ! autocomplete_loaded )); then
  autoload -Uz compinit && compinit
fi

# Keep the Omarchy shell environment, aliases, and helper functions available
# after moving away from its Bash default. Shared definitions below take
# precedence when both platforms provide the same shortcut.
if [[ -n "${OMARCHY_PATH:-}" ]]; then
  [[ -r "$OMARCHY_PATH/default/bash/envs" ]] && source "$OMARCHY_PATH/default/bash/envs"
  [[ -r "$OMARCHY_PATH/default/bash/aliases" ]] && source "$OMARCHY_PATH/default/bash/aliases"
  # Oh My Zsh's Git shortcuts use ga/gd as aliases; Omarchy defines those as
  # worktree functions. Remove the aliases so the function definitions parse
  # and remain callable under Zsh.
  unalias ga gd 2>/dev/null || true
  [[ -r "$OMARCHY_PATH/default/bash/functions" ]] && source "$OMARCHY_PATH/default/bash/functions"
fi

[[ -r "$DOTFILES_DIR/shared/shell/path.sh" ]] && source "$DOTFILES_DIR/shared/shell/path.sh"
[[ -r "$DOTFILES_DIR/shared/shell/aliases" ]] && source "$DOTFILES_DIR/shared/shell/aliases"

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

for module in functions tools; do
  [[ -r "$DOTFILES_DIR/shared/shell/$module.sh" ]] && source "$DOTFILES_DIR/shared/shell/$module.sh"
done

# Omarchy already loads these helpers from its packaged shell defaults. Load
# the portable Zsh versions only on macOS to avoid redefining them on Linux.
if [[ "$(uname -s)" == Darwin ]]; then
  [[ -r "$DOTFILES_DIR/shared/shell/omarchy-portable.zsh" ]] &&
    source "$DOTFILES_DIR/shared/shell/omarchy-portable.zsh"
fi

# fzf ships shell integration in both the Arch and Homebrew layouts.
source_first \
  /usr/share/fzf/completion.zsh \
  "$brew_prefix/opt/fzf/shell/completion.zsh" || true
source_first \
  /usr/share/fzf/key-bindings.zsh \
  "$brew_prefix/opt/fzf/shell/key-bindings.zsh" || true

source_first \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  "$brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" || true

[[ -r "$DOTFILES_DIR/.local/shell.sh" ]] && source "$DOTFILES_DIR/.local/shell.sh"

# Syntax highlighting must be the final interactive plugin sourced.
source_first \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" || true

unfunction source_first
unset autocomplete_loaded brew_prefix
