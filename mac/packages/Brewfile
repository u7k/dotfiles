# Taps used by retained packages or shell integrations.
tap "barutsrb/tap" # Provides the OmniWM window manager cask.
tap "bjarneo/cliamp" # Provides the cliamp terminal music player.
tap "homebrew/command-not-found" # Suggests Homebrew packages for unknown shell commands.
tap "homebrew/services" # Adds service management commands to Homebrew.
tap "jnsahaj/lumen" # Provides the Lumen Git diff and code-review TUI.
tap "teamookla/speedtest" # Provides Ookla's official Speedtest CLI.

# Shell and daily command-line tools.
brew "atuin" # Searchable, synchronized shell history.
brew "bat" # Syntax-highlighted replacement for cat and fzf previews.
brew "btop" # Interactive terminal resource monitor.
