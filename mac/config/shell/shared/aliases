# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias home='cd ~'
alias x='exit'

# Fall back to the standard ls command when eza is unavailable.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lah --group-directories-first --git'
  alias lsa='eza -a --group-directories-first'
else
  alias ll='ls -lah'
  alias lsa='ls -a'
fi

command -v btop >/dev/null 2>&1 && alias top='btop'
alias lg='lazygit'
alias cpd='copypath'

# Git shortcuts retained from the current shell setup.
alias hawktuah='git add -A'
alias add='git add'
alias commit='git commit'
alias commitm='git commit -m'
alias push='git push'
alias stat='git status'
alias gdiff='git diff HEAD'
alias vdiff='git difftool HEAD'
alias gitlog="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
